# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# See docs/04-architecture.md §6 and docs/09-accounts-and-costs.md.

# UN Comtrade "Basic Individual" key, for pnpm fetch:comtrade (local only)
COMTRADE_KEY=

# Internet Archive S3-style keys, for authenticated Save Page Now in pnpm archive (local only)
IA_ACCESS_KEY=
IA_SECRET_KEY=

# Phase gate (D-16). Stays false until the author flips it; set in .env.production.
NEXT_PUBLIC_SHOW_SCORES=false

# Canonical site URL, used for canonical links, citations and share cards
NEXT_PUBLIC_SITE_URL=

# Deploy credentials live only in GitHub Actions secrets, never in .env:
#   CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
