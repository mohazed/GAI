{
  "name": "gaza-accountability-index",
  "private": true,
  "description": "Scores every state's conduct regarding Gaza since 7 October 2023; every point tied to a dated, archived source.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @gai/web test:e2e",
    "validate": "tsx packages/schema/src/cli/validate.ts",
    "score": "tsx packages/pipeline/src/cli/score.ts",
    "methodology:render": "tsx packages/schema/src/cli/render-methodology.ts",
    "archive": "tsx packages/pipeline/src/cli/archive.ts",
    "check:wayback": "tsx packages/pipeline/src/cli/check-wayback.ts",
    "fetch:fts": "tsx packages/pipeline/src/cli/fetch-fts.ts",
    "fetch:worldbank": "tsx packages/pipeline/src/cli/fetch-worldbank.ts",
    "fetch:comtrade": "tsx packages/pipeline/src/cli/fetch-comtrade.ts",
    "import:unvotes": "tsx packages/pipeline/src/cli/import-unvotes.ts",
    "import:sipri": "tsx packages/pipeline/src/cli/import-sipri.ts",
    "build:data": "tsx packages/pipeline/src/cli/build-data.ts",
    "build:data:check": "tsx packages/pipeline/src/cli/build-data-check.ts",
    "publish:events": "tsx packages/pipeline/src/cli/publish-events.ts",
    "build": "pnpm build:data && turbo run build",
    "dev": "pnpm --filter @gai/web dev",
    "calibrate": "tsx packages/pipeline/src/cli/calibrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "tsx": "catalog:",
    "turbo": "2.11.4",
    "typescript": "catalog:",
    "wrangler": "4.142.0"
  }
}
