{
  "name": "gaza-accountability-index",
  "private": true,
  "description": "Scores every state's conduct regarding Gaza since 7 October 2023; every point tied to a dated, archived source.",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "validate": "tsx packages/schema/src/cli/validate.ts",
    "score": "tsx packages/pipeline/src/cli/score.ts",
    "methodology:render": "tsx packages/schema/src/cli/render-methodology.ts",
    "archive": "tsx packages/pipeline/src/cli/archive.ts",
    "fetch:fts": "tsx packages/pipeline/src/cli/fetch-fts.ts",
    "fetch:worldbank": "tsx packages/pipeline/src/cli/fetch-worldbank.ts",
    "fetch:comtrade": "tsx packages/pipeline/src/cli/fetch-comtrade.ts",
    "import:unvotes": "tsx packages/pipeline/src/cli/import-unvotes.ts",
    "import:sipri": "tsx packages/pipeline/src/cli/import-sipri.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "2.11.4",
    "typescript": "catalog:",
    "tsx": "catalog:"
  }
}
