{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["out/**"],
      "env": ["NEXT_PUBLIC_SHOW_SCORES", "GAI_KIT"]
    }
  }
}
